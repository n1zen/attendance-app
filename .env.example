# Signs session cookies (admin login + "remember this device" for scanners).
# Generate a new random value for your environment, e.g.:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=change-me-to-a-long-random-string

# Optional: the app's display name (page titles, headers, exported files).
# Defaults to "AttendanceApp" when unset. Takes effect after a rebuild.
# APP_NAME=ACME Attendance

# Optional locally: override the SQLite database location (a bare path works
# too). Defaults to a local SQLite file created on first use.
# On Vercel this is REQUIRED: use your Turso database URL.
# DATABASE_URL=file:./data/attendance.db
# DATABASE_URL=libsql://your-db-your-org.turso.io

# Only when using a hosted Turso database (e.g. on Vercel).
# TURSO_AUTH_TOKEN=eyJ...
