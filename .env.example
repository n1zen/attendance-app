# Signs session cookies (admin login + "remember this device" for scanners).
# Generate a new random value for your environment, e.g.:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=change-me-to-a-long-random-string

# Optional: point at your own MongoDB instead of the built-in local dev database
# (mongodb-memory-server, stored in ./.data/db). Include a database name.
# MONGODB_URI=mongodb://127.0.0.1:27017/attendanceapp
